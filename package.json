{
    "name": "equinox-margin-protocol",
    "version": "1.0.0",
    "description": "Motor de margen multi-activo con subcuentas aisladas y liquidacion determinista.",
    "private": true,
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check \"src/core/CapitalStressEngine.sol\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \"*.json\" \".github/**/*.yml\"",
        "format": "prettier --write \"src/core/CapitalStressEngine.sol\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \"*.json\" \".github/**/*.yml\"",
        "loc": "node scripts/check-loc.mjs",
        "size": "node scripts/check-contract-size.mjs",
        "verify:release": "node scripts/verify-release.mjs",
        "ci": "bash scripts/ci.sh"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "6.1.2",
        "hardhat": "2.29.0",
        "prettier": "3.9.6",
        "prettier-plugin-solidity": "2.4.1",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    }
}
