{
    "name": "equinox-margin-protocol",
    "version": "1.0.0",
    "description": "Isolated-account multiasset margin protocol",
    "private": true,
    "scripts": {
        "compile": "hardhat compile",
        "test": "hardhat test",
        "lint": "prettier --check \"src/**/*.sol\" \"tests/**/*.ts\" \"*.md\" \"*.json\" \".github/**/*.yml\"",
        "format": "prettier --write \"src/**/*.sol\" \"tests/**/*.ts\" \"*.md\" \"*.json\" \".github/**/*.yml\"",
        "fmt": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
        "ci": "npm run lint && npm run compile && npm test"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "^6.1.0",
        "hardhat": "^3.9.1",
        "prettier": "^3.6.2",
        "prettier-plugin-solidity": "^1.4.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
