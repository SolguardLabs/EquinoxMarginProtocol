{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "mocha"]
    },
    "include": ["./hardhat.config.ts", "./tests/**/*.ts", "./scripts/**/*.ts"]
}
